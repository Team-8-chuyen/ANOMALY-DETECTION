        <mxCell id="s38" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;fontSize=13;" value="&lt;b&gt;&amp;#128161; Ví dụ minh họa&lt;/b&gt;&lt;br&gt;Anh A thường đăng nhập lúc 8h sáng, gửi khoảng 20 email/ngày, hiếm khi dùng USB. Một ngày, A đăng nhập lúc 1h sáng, cắm USB và sao chép hàng trăm file.&lt;br&gt;→ Mô hình &amp;quot;vẽ lại&amp;quot; ngày này rất sai → lạ hơn gần như mọi ngày bình thường của A → điểm rủi ro ≈ 0,99 &amp;gt; ngưỡng → &lt;b&gt;phát cảnh báo&lt;/b&gt;." vertex="1">
          <mxGeometry height="90" width="1400" x="40" y="690" as="geometry" />
        </mxCell>
        <mxCell id="s39" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=14;" value="&lt;b&gt;Khi đưa vào vận hành thực tế&lt;/b&gt; (phần backend — dùng lại mô hình &amp;amp; chuẩn đã học, không học lại)" vertex="1">
