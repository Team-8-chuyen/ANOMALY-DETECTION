  <diagram id="simple" name="Quy trình tổng quan">
    <mxGraphModel dx="2084" dy="1444" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2000" pageHeight="1300" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="Phát hiện hành vi bất thường của nhân viên (Insider Threat) — quy trình từ đầu đến cuối" id="s1">
          <mxCell parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=26;fontStyle=1;" vertex="1">
            <mxGeometry height="40" width="1900" x="40" y="20" as="geometry" />
          </mxCell>
        </UserObject>
        <mxCell id="s2" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=14;fontColor=#333333;" value="&lt;b&gt;Ý tưởng cốt lõi:&lt;/b&gt; hệ thống tự học &lt;b&gt;thói quen làm việc bình thường&lt;/b&gt; của từng nhân viên từ nhật ký máy tính. Ngày nào hành vi &lt;b&gt;khác xa thói quen&lt;/b&gt; → điểm rủi ro cao → phát &lt;b&gt;cảnh báo&lt;/b&gt; để người điều tra xem xét. Mô hình &lt;u&gt;không cần biết trước&lt;/u&gt; ai là kẻ xấu." vertex="1">
          <mxGeometry height="44" width="1900" x="40" y="66" as="geometry" />
        </mxCell>
        <mxCell id="s3" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d6b656;strokeColor=none;fontColor=#ffffff;fontSize=13;" value="&lt;b&gt;GIAI ĐOẠN 1 · CHUẨN BỊ DỮ LIỆU&lt;/b&gt;" vertex="1">
          <mxGeometry height="34" width="624" x="40" y="130" as="geometry" />
        </mxCell>
        <mxCell id="s4" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#6c8ebf;strokeColor=none;fontColor=#ffffff;fontSize=13;" value="&lt;b&gt;GIAI ĐOẠN 2 · HỌC THÓI QUEN &amp; CHẤM ĐIỂM&lt;/b&gt;" vertex="1">
          <mxGeometry height="34" width="838" x="682" y="130" as="geometry" />
        </mxCell>
        <mxCell id="s5" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#82b366;strokeColor=none;fontColor=#ffffff;fontSize=13;" value="&lt;b&gt;GIAI ĐOẠN 3 · QUYẾT ĐỊNH &amp; ĐÁNH GIÁ&lt;/b&gt;" vertex="1">
          <mxGeometry height="34" width="410" x="1538" y="130" as="geometry" />
        </mxCell>
        <mxCell id="s6" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=26;" value="&lt;div style=&#39;font-size:14px;font-weight:bold;color:#7a5c00;margin-bottom:6px&#39;&gt;Thu thập nhật ký&lt;/div&gt;&lt;div style=&#39;font-size:12px;color:#222&#39;&gt;Lấy 5 loại nhật ký máy tính của công ty:&lt;br&gt;• Đăng nhập / đăng xuất&lt;br&gt;• Cắm / rút USB&lt;br&gt;• Sao chép file&lt;br&gt;• Truy cập web&lt;br&gt;• Email&lt;br&gt;+ danh sách nhân viên &amp; chức vụ.&lt;/div&gt;&lt;div style=&#39;font-size:11px;color:#555;font-style:italic;margin-top:8px&#39;&gt;Dữ liệu mẫu: CERT r4.2 (~1.000 nhân viên, 17 tháng).&lt;/div&gt;&lt;div style=&#39;font-size:10px;color:#888;margin-top:8px&#39;&gt;&amp;#128196; data/raw/cert4.2&lt;/div&gt;" vertex="1">
          <mxGeometry height="330" width="196" x="40" y="190" as="geometry" />
        </mxCell>
        <mxCell id="s7" parent="1" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d6b656;strokeColor=#ffffff;strokeWidth=3;fontColor=#ffffff;fontSize=18;" value="&lt;b&gt;1&lt;/b&gt;" vertex="1">
          <mxGeometry height="40" width="40" x="50" y="174" as="geometry" />
        </mxCell>
        <mxCell id="s8" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=26;" value="&lt;div style=&#39;font-size:14px;font-weight:bold;color:#7a5c00;margin-bottom:6px&#39;&gt;Tóm tắt theo từng ngày&lt;/div&gt;&lt;div style=&#39;font-size:12px;color:#222&#39;&gt;Với mỗi &lt;b&gt;nhân viên × mỗi ngày&lt;/b&gt;, tạo 2 bản tóm tắt:&lt;br&gt;① &lt;b&gt;Bảng chỉ số&lt;/b&gt; (128 con số: số lần đăng nhập, số email, số file...)&lt;br&gt;② &lt;b&gt;Chuỗi hành động&lt;/b&gt; theo thứ tự thời gian.&lt;br&gt;Chỉ dùng thông tin mô tả, &lt;u&gt;không đọc nội dung&lt;/u&gt;.&lt;/div&gt;&lt;div style=&#39;font-size:10px;color:#888;margin-top:8px&#39;&gt;&amp;#128196; cli/build_store.py&lt;/div&gt;" vertex="1">
          <mxGeometry height="330" width="196" x="254" y="190" as="geometry" />
        </mxCell>
        <mxCell id="s9" parent="1" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d6b656;strokeColor=#ffffff;strokeWidth=3;fontColor=#ffffff;fontSize=18;" value="&lt;b&gt;2&lt;/b&gt;" vertex="1">
          <mxGeometry height="40" width="40" x="264" y="174" as="geometry" />
        </mxCell>
        <mxCell id="s10" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=26;" value="&lt;div style=&#39;font-size:14px;font-weight:bold;color:#7a5c00;margin-bottom:6px&#39;&gt;Nhìn 30 ngày gần nhất&lt;/div&gt;&lt;div style=&#39;font-size:12px;color:#222&#39;&gt;Để hiểu ngày D, hệ thống xem ngày D &lt;b&gt;cùng 29 ngày trước đó&lt;/b&gt; — giống như xem nhật ký một tháng của người đó.&lt;br&gt;&lt;br&gt;Không bao giờ dùng dữ liệu của tương lai.&lt;/div&gt;&lt;div style=&#39;font-size:10px;color:#888;margin-top:8px&#39;&gt;&amp;#128196; insider_ml/dataset.py&lt;/div&gt;" vertex="1">
          <mxGeometry height="330" width="196" x="468" y="190" as="geometry" />
        </mxCell>
        <mxCell id="s11" parent="1" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d6b656;strokeColor=#ffffff;strokeWidth=3;fontColor=#ffffff;fontSize=18;" value="&lt;b&gt;3&lt;/b&gt;" vertex="1">
          <mxGeometry height="40" width="40" x="478" y="174" as="geometry" />
        </mxCell>
        <mxCell id="s12" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=26;" value="&lt;div style=&#39;font-size:14px;font-weight:bold;color:#1f4e8c;margin-bottom:6px&#39;&gt;Học thói quen bình thường&lt;/div&gt;&lt;div style=&#39;font-size:12px;color:#222&#39;&gt;Mô hình AI (Autoencoder) tập &lt;b&gt;&amp;quot;ghi nhớ rồi vẽ lại&amp;quot;&lt;/b&gt; hành vi của nhân viên.&lt;br&gt;&lt;br&gt;Hành vi quen thuộc → vẽ lại &lt;b&gt;đúng&lt;/b&gt;.&lt;br&gt;Hành vi lạ → vẽ lại &lt;b&gt;sai nhiều&lt;/b&gt;.&lt;/div&gt;&lt;div style=&#39;font-size:11px;color:#555;font-style:italic;margin-top:8px&#39;&gt;Học trên dữ liệu 5 tháng đầu, không dùng đáp án.&lt;/div&gt;&lt;div style=&#39;font-size:10px;color:#888;margin-top:8px&#39;&gt;&amp;#128196; cli/train.py · model.py&lt;/div&gt;" vertex="1">
          <mxGeometry height="330" width="196" x="682" y="190" as="geometry" />
        </mxCell>
        <mxCell id="s13" parent="1" style="ellipse;whiteSpace=wrap;html=1;fillColor=#6c8ebf;strokeColor=#ffffff;strokeWidth=3;fontColor=#ffffff;fontSize=18;" value="&lt;b&gt;4&lt;/b&gt;" vertex="1">
          <mxGeometry height="40" width="40" x="692" y="174" as="geometry" />
        </mxCell>
        <mxCell id="s14" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=26;" value="&lt;div style=&#39;font-size:14px;font-weight:bold;color:#1f4e8c;margin-bottom:6px&#39;&gt;Đo mức &amp;quot;lạ&amp;quot; mỗi ngày&lt;/div&gt;&lt;div style=&#39;font-size:12px;color:#222&#39;&gt;Mỗi ngày nhận &lt;b&gt;2 điểm lệch&lt;/b&gt;:&lt;br&gt;• Lệch theo &lt;b&gt;bảng chỉ số&lt;/b&gt;&lt;br&gt;• Lệch theo &lt;b&gt;chuỗi hành động&lt;/b&gt;&lt;br&gt;&lt;br&gt;Vẽ lại càng sai → điểm lệch càng cao.&lt;/div&gt;&lt;div style=&#39;font-size:10px;color:#888;margin-top:8px&#39;&gt;&amp;#128196; cli/score.py&lt;/div&gt;" vertex="1">
          <mxGeometry height="330" width="196" x="896" y="190" as="geometry" />
        </mxCell>
        <mxCell id="s15" parent="1" style="ellipse;whiteSpace=wrap;html=1;fillColor=#6c8ebf;strokeColor=#ffffff;strokeWidth=3;fontColor=#ffffff;fontSize=18;" value="&lt;b&gt;5&lt;/b&gt;" vertex="1">
          <mxGeometry height="40" width="40" x="906" y="174" as="geometry" />
        </mxCell>
        <mxCell id="s16" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=26;" value="&lt;div style=&#39;font-size:14px;font-weight:bold;color:#1f4e8c;margin-bottom:6px&#39;&gt;So với chuẩn phù hợp&lt;/div&gt;&lt;div style=&#39;font-size:12px;color:#222&#39;&gt;Điểm lệch được so với một &lt;b&gt;chuẩn tham chiếu&lt;/b&gt;, ưu tiên theo thứ tự:&lt;br&gt;① Chính người đó&lt;br&gt;② Người cùng chức vụ&lt;br&gt;③ Toàn công ty&lt;br&gt;(chưa đủ lịch sử thì lùi xuống bậc sau)&lt;/div&gt;&lt;div style=&#39;font-size:11px;color:#555;font-style:italic;margin-top:8px&#39;&gt;VD: &amp;quot;ngày này lạ hơn 99% ngày bình thường của anh A&amp;quot;.&lt;/div&gt;&lt;div style=&#39;font-size:10px;color:#888;margin-top:8px&#39;&gt;&amp;#128196; backend/app/domain/readiness.py&lt;/div&gt;" vertex="1">
          <mxGeometry height="330" width="196" x="1110" y="190" as="geometry" />
        </mxCell>
        <mxCell id="s17" parent="1" style="ellipse;whiteSpace=wrap;html=1;fillColor=#6c8ebf;strokeColor=#ffffff;strokeWidth=3;fontColor=#ffffff;fontSize=18;" value="&lt;b&gt;6&lt;/b&gt;" vertex="1">
          <mxGeometry height="40" width="40" x="1120" y="174" as="geometry" />
        </mxCell>
        <mxCell id="s18" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=26;" value="&lt;div style=&#39;font-size:14px;font-weight:bold;color:#1f4e8c;margin-bottom:6px&#39;&gt;Gộp thành điểm rủi ro&lt;/div&gt;&lt;div style=&#39;font-size:12px;color:#222&#39;&gt;Kết hợp 2 điểm đã so chuẩn thành &lt;b&gt;1 điểm rủi ro từ 0 đến 1&lt;/b&gt;.&lt;br&gt;&lt;br&gt;Chỉ cần &lt;b&gt;một trong hai&lt;/b&gt; nhánh rất lạ là điểm rủi ro đã cao.&lt;br&gt;&lt;br&gt;Ngày không có hoạt động → không chấm.&lt;/div&gt;&lt;div style=&#39;font-size:10px;color:#888;margin-top:8px&#39;&gt;&amp;#128196; insider_ml/fusion.py&lt;/div&gt;" vertex="1">
          <mxGeometry height="330" width="196" x="1324" y="190" as="geometry" />
        </mxCell>
        <mxCell id="s19" parent="1" style="ellipse;whiteSpace=wrap;html=1;fillColor=#6c8ebf;strokeColor=#ffffff;strokeWidth=3;fontColor=#ffffff;fontSize=18;" value="&lt;b&gt;7&lt;/b&gt;" vertex="1">
          <mxGeometry height="40" width="40" x="1334" y="174" as="geometry" />
        </mxCell>
        <mxCell id="s20" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=26;" value="&lt;div style=&#39;font-size:14px;font-weight:bold;color:#2d6a1f;margin-bottom:6px&#39;&gt;Cảnh báo&lt;/div&gt;&lt;div style=&#39;font-size:12px;color:#222&#39;&gt;Chọn &lt;b&gt;ngưỡng&lt;/b&gt; sao cho chỉ khoảng &lt;b&gt;0,5% ngày rủi ro nhất&lt;/b&gt; bị cảnh báo, rồi &lt;b&gt;khóa cố định&lt;/b&gt; ngưỡng.&lt;br&gt;&lt;br&gt;Điểm ≥ ngưỡng → tạo &lt;b&gt;cảnh báo&lt;/b&gt; cho người điều tra.&lt;/div&gt;&lt;div style=&#39;font-size:10px;color:#888;margin-top:8px&#39;&gt;&amp;#128196; cli/evaluate_metrics.py&lt;/div&gt;" vertex="1">
          <mxGeometry height="330" width="196" x="1538" y="190" as="geometry" />
        </mxCell>
        <mxCell id="s21" parent="1" style="ellipse;whiteSpace=wrap;html=1;fillColor=#82b366;strokeColor=#ffffff;strokeWidth=3;fontColor=#ffffff;fontSize=18;" value="&lt;b&gt;8&lt;/b&gt;" vertex="1">
          <mxGeometry height="40" width="40" x="1548" y="174" as="geometry" />
        </mxCell>
        <mxCell id="s22" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=26;" value="&lt;div style=&#39;font-size:14px;font-weight:bold;color:#2d6a1f;margin-bottom:6px&#39;&gt;Đánh giá kết quả&lt;/div&gt;&lt;div style=&#39;font-size:12px;color:#222&#39;&gt;Đến cuối cùng mới mở &lt;b&gt;đáp án&lt;/b&gt; (ai thật sự là insider) để chấm mô hình:&lt;br&gt;• Bắt được bao nhiêu vụ?&lt;br&gt;• Báo nhầm bao nhiêu?&lt;br&gt;• Phát hiện sớm hay muộn?&lt;/div&gt;&lt;div style=&#39;font-size:11px;color:#555;font-style:italic;margin-top:8px&#39;&gt;Kết quả → experiment_report.json&lt;/div&gt;&lt;div style=&#39;font-size:10px;color:#888;margin-top:8px&#39;&gt;&amp;#128196; cli/run_experiment.py&lt;/div&gt;" vertex="1">
