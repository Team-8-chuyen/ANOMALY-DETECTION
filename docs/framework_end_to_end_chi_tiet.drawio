xGeometry x="520" y="450" width="170" height="110" as="geometry"/></mxCell><mxCell id="3. 18" value="&lt;b&gt;ROLE&lt;/b&gt; đủ?&lt;br&gt;&lt;font style=&#x27;font-size:9px&#x27;&gt;≥15 peer, ≥300 seq-days,&lt;br&gt;≥10.000 transitions,&lt;br&gt;≥2.000 trong 30d gần nhất&lt;/font&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=10;" vertex="1" parent="1"><mxGeometry x="730" y="450" width="170" height="110" as="geometry"/></mxCell><mxCell id="3. 19" value="&lt;b&gt;GLOBAL&lt;/b&gt; đủ?&lt;br&gt;&lt;font style=&#x27;font-size:9px&#x27;&gt;≥200 users, ≥10.000 seq-days,&lt;br&gt;≥100.000 transitions&lt;/font&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=10;" vertex="1" parent="1"><mxGeometry x="940" y="450" width="170" height="110" as="geometry"/></mxCell><mxCell id="3. 20" value="&lt;b&gt;NO_SCORE&lt;/b&gt;&lt;br&gt;S_INSUFFICIENT_DATA&lt;br&gt;/ S_CURRENT_LEN_LT_2" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;align=left;spacingLeft=8;verticalAlign=top;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="1130" y="475" width="150" height="60" as="geometry"/></mxCell><mxCell id="3. 21" value="&lt;b&gt;Calibrate&lt;/b&gt; trong ECDF của level đã chọn&lt;br&gt;q_S = percentile(E_S)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;align=left;spacingLeft=8;spacingRight=6;verticalAlign=top;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="520" y="640" width="380" height="60" as="geometry"/></mxCell><mxCell id="3. 22" value="có" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="3. 16" target="3. 17"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="3. 23" value="không" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.5;dashed=1;strokeColor=#b85450;fontColor=#b85450;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="3. 16" target="3. 20"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="415" y="725"/><mxPoint x="1205" y="725"/></Array></mxGeometry></mxCell><mxCell id="3. 24" value="thiếu" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="3. 17" target="3. 18"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="3. 25" value="thiếu / role unknown" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="3. 18" target="3. 19"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="3. 26" value="thiếu" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.5;dashed=1;strokeColor=#b85450;fontColor=#b85450;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="3. 19" target="3. 20"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="3. 27" value="đủ" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#82b366;fontColor=#2d7a1f;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="3. 17" target="3. 21"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="3. 28" value="đủ" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#82b366;fontColor=#2d7a1f;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="3. 18" target="3. 21"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="3. 29" value="đủ" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#82b366;fontColor=#2d7a1f;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="3. 19" target="3. 21"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1025" y="600"/><mxPoint x="850" y="600"/></Array></mxGeometry></mxCell><mxCell id="3. 30" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="3. 2" target="3. 4"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="280" y="355"/><mxPoint x="280" y="155"/></Array></mxGeometry></mxCell><mxCell id="3. 31" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="3. 2" target="3. 16"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="280" y="355"/><mxPoint x="280" y="495"/></Array></mxGeometry></mxCell><mxCell id="3. 32" value="&lt;b&gt;Fusion  (insider_ml/fusion.py · backend domain/fusion.py)&lt;/b&gt;&lt;br&gt;• cả hai có: noisy_or.v1 (v7): risk = 1 − (1−q_F)(1−q_S)&lt;br&gt;•   (v6: weighted_mean 0.5·q_F + 0.5·q_S)&lt;br&gt;• chỉ 1 branch: risk = q của branch đó (renormalize)&lt;br&gt;• cả hai NO_SCORE: risk = None → NO_SCORE, không alert&lt;br&gt;• risk là anomaly index, không phải xác suất" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;align=left;spacingLeft=8;spacingRight=6;verticalAlign=top;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="1360" y="330" width="420" height="150" as="geometry"/></mxCell><mxCell id="3. 33" value="q_F" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="3. 8" target="3. 32"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1330" y="320"/><mxPoint x="1570" y="320"/></Array></mxGeometry></mxCell><mxCell id="3. 34" value="q_S" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="3. 21" target="3. 32"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1330" y="670"/><mxPoint x="1570" y="670"/></Array></mxGeometry></mxCell><mxCell id="3. 35" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=open;endFill=0;strokeWidth=1.2;dashed=1;strokeColor=#666666;fontColor=#666666;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="3. 7" target="3. 32"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="3. 36" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=open;endFill=0;strokeWidth=1.2;dashed=1;strokeColor=#666666;fontColor=#666666;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="3. 20" target="3. 32"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="3. 37" value="&lt;b&gt;risk ≥ LOCKED threshold?&lt;/b&gt;&lt;br&gt;(quantile 0.995 của risk Validation, không nhãn)" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1380" y="800" width="380" height="120" as="geometry"/></mxCell><mxCell id="3. 38" value="&lt;b&gt;RiskAssessment (immutable)&lt;/b&gt;&lt;br&gt;• lưu q_F, q_S, level, reason codes, weights, config version" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;align=left;spacingLeft=8;spacingRight=6;verticalAlign=top;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="1000" y="980" width="340" height="80" as="geometry"/></mxCell><mxCell id="3. 39" value="&lt;b&gt;Alert → điều tra&lt;/b&gt;&lt;br&gt;• PATCH status/assignee/resolution&lt;br&gt;• không sửa score nguồn" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;align=left;spacingLeft=8;verticalAlign=top;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="1460" y="980" width="300" height="90" as="geometry"/></mxCell><mxCell id="3. 40" value="&lt;b&gt;Safe update (PRODUCTION only)&lt;/b&gt;&lt;br&gt;• không alert trong [D, D+30] &amp; cùng role epoch&lt;br&gt;• → eligible D+31 → Person ref version mới" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;fontSize=10;align=left;spacingLeft=8;verticalAlign=top;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="520" y="980" width="360" height="90" as="geometry"/></mxCell><mxCell id="3. 41" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="3. 32" target="3. 37"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="3. 42" value="có" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.5;dashed=1;strokeColor=#b85450;fontColor=#b85450;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="3. 37" target="3. 39"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="3. 43" value="luôn ghi" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="3. 37" target="3. 38"><mxGeometry relative="1" as="geometry"><Array as="points"><m