ry x="1550" y="255" width="380" height="40" as="geometry"/></mxCell><mxCell id="2. 34" value="&lt;b&gt;Calendar decoder&lt;/b&gt; Linear(C,3)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1550" y="310" width="380" height="40" as="geometry"/></mxCell><mxCell id="2. 35" value="&lt;b&gt;Gap decoder&lt;/b&gt; Linear(C, |gap buckets|)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1550" y="365" width="380" height="40" as="geometry"/></mxCell><mxCell id="2. 36" value="&lt;b&gt;Time decoder&lt;/b&gt; Linear(C,2) + Tanh" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1550" y="420" width="380" height="40" as="geometry"/></mxCell><mxCell id="2. 37" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="2. 23" target="2. 31"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1480" y="472"/></Array></mxGeometry></mxCell><mxCell id="2. 38" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="2. 23" target="2. 32"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1480" y="472"/></Array></mxGeometry></mxCell><mxCell id="2. 39" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="2. 23" target="2. 33"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1480" y="472"/></Array></mxGeometry></mxCell><mxCell id="2. 40" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="2. 23" target="2. 34"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1480" y="472"/></Array></mxGeometry></mxCell><mxCell id="2. 41" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="2. 23" target="2. 35"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1480" y="472"/></Array></mxGeometry></mxCell><mxCell id="2. 42" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="2. 23" target="2. 36"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1480" y="472"/></Array></mxGeometry></mxCell><mxCell id="2. 43" value="Loss &amp;amp; Score" style="swimlane;horizontal=0;startSize=34;fontStyle=1;fontSize=14;rounded=0;html=1;whiteSpace=wrap;fillColor=#fff2cc;strokeColor=#d6b656;swimlaneFillColor=#fffdf5;" vertex="1" parent="1"><mxGeometry x="40" y="570" width="1920" height="250" as="geometry"/></mxCell><mxCell id="2. 44" value="&lt;b&gt;Train — reconstruction_loss (training.py)&lt;/b&gt;&lt;br&gt;• feature_loss: chỉ trên vị trí mask = true&lt;br&gt;• sequence_loss: token / PC / calendar / gap (CE) + time (MSE), trọng số bằng nhau, bỏ PAD&lt;br&gt;• &lt;b&gt;total_loss = 0.5 × feature_loss + 0.5 × sequence_loss&lt;/b&gt;&lt;br&gt;• Reconstruct đủ 30 ngày cho mỗi endpoint" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=left;spacingLeft=8;spacingRight=6;verticalAlign=top;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="90" y="610" width="620" height="130" as="geometry"/></mxCell><mxCell id="2. 45" value="&lt;b&gt;Inference — daily_branch_reconstruction_scores (inference.py)&lt;/b&gt;&lt;br&gt;• Chỉ lấy error của &lt;b&gt;ngày cuối D&lt;/b&gt; trong cửa sổ&lt;br&gt;• E_F = feature_raw(D),  E_S = sequence_raw(D)  (giữ riêng, không cộng)&lt;br&gt;• fit_reference(level, scope, scores) → ECDF&lt;br&gt;• calibrated_tail_score(raw, ref) → q ∈ [0,1]" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;align=left;spacingLeft=8;spacingRight=6;verticalAlign=top;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="760" y="610" width="620" height="130" as="geometry"/></mxCell><mxCell id="2. 46" value="&lt;b&gt;E_F(D), E_S(D)&lt;/b&gt;&lt;br&gt;→ trang 3: Readiness · Calibration · Fusion" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1440" y="630" width="420" height="80" as="geometry"/></mxCell><mxCell id="2. 47" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="2. 45" target="2. 46"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="2. 48" value="Lưu ý: Person / Role / Global là 3 phân phối calibration, KHÔNG phải 3 model riêng. Chỉ có 1 model duy nhất." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=11;whiteSpace=wrap;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="90" y="760" width="1400" height="30" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="3. " name="3. Readiness - Fusion - Decision"><mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2000" pageHeight="1250" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="3. 1" value="Scoring của một employee-day D: Readiness → Calibration → Fusion → Threshold → Alert" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=22;fontStyle=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="1800" height="36" as="geometry"/></mxCell><mxCell id="3. 2" value="&lt;b&gt;Employee-day (u, D)&lt;/b&gt;&lt;br&gt;E_F(D), E_S(D)&lt;br&gt;+ role epoch tại D&lt;br&gt;+ frozen references (fitted_through &amp;lt; D)" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=12;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;align=left;spacingLeft=6;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="40" y="300" width="220" height="110" as="geometry"/></mxCell><mxCell id="3. 3" value="Feature branch — readiness độc lập" style="swimlane;horizontal=0;startSize=34;fontStyle=1;fontSize=14;rounded=0;html=1;whiteSpace=wrap;fillColor=#e1d5e7;strokeColor=#9673a6;swimlaneFillColor=#fcf9fd;" vertex="1" parent="1"><mxGeometry x="300" y="70" width="1000" height="330" as="geometry"/></mxCell><mxCell id="3. 4" value="&lt;b&gt;PERSON&lt;/b&gt; đủ?&lt;br&gt;&lt;font style=&#x27;font-size:9px&#x27;&gt;≥60 active days, span 90d,&lt;br&gt;60d trong role hiện tại,&lt;br&gt;≥90% của 124 feature có ≥40 obs,&lt;br&gt;stale gap ≤30d&lt;/font&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=10;" vertex="1" parent="1"><mxGeometry x="340" y="100" width="170" height="110" as="geometry"/></mxCell><mxCell id="3. 5" value="&lt;b&gt;ROLE&lt;/b&gt; đủ?&lt;br&gt;&lt;font style=&#x27;font-size:9px&#x27;&gt;role known, ≥15 peer,&lt;br&gt;≥300 peer user-days,&lt;br&gt;≥90% feature có ≥200 support&lt;/font&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=10;" vertex="1" parent="1"><mxGeometry x="550" y="100" width="170" height="110" as="geometry"/></mxCell><mxCell id="3. 6" value="&lt;b&gt;GLOBAL&lt;/b&gt; đủ?&lt;br&gt;&lt;font style=&#x27;font-size:9px&#x27;&gt;≥200 users, ≥10.000 user-days,&lt;br&gt;fit Train-only&lt;/font&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=10;" vertex="1" parent="1"><mxGeometry x="760" y="100" width="170" height="110" as="geometry"/></mxCell><mxCell id="3. 7" value="&lt;b&gt;NO_SCORE&lt;/b&gt;&lt;br&gt;F_INSUFFICIENT_DATA" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;align=left;spacingLeft=8;verticalAlign=top;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="1130" y="125" width="150" height="60" as="geometry"/></mxCell><mxCell id="3. 8" value="&lt;b&gt;Calibrate&lt;/b&gt; trong ECDF của level đã chọn&lt;br&gt;q_F = percentile(E_F)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;align=left;spacingLeft=8;spacingRight=6;verticalAlign=top;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="340" y="290" width="380" height="60" as="geometry"/></mxCell><mxCell id="3. 9" value="thiếu" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="3. 4" target="3. 5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="3. 10" value="thiếu / role unknown" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="3. 5" target="3. 6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="3. 11" value="thiếu" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.5;dashed=1;strokeColor=#b85450;fontColor=#b85450;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="3. 6" target="3. 7"><mxGeometry relative="1" as="geometry"></mxGeometry