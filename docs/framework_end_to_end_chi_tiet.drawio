<mxfile host="app.diagrams.net" agent="claude" version="24.0.0"><diagram id="1. " name="1. End-to-end framework"><mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2700" pageHeight="1900" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="1. 1" value="Insider Threat Anomaly Detection — Framework end-to-end (CERT r4.2, framework.v7)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=22;fontStyle=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="1800" height="36" as="geometry"/></mxCell><mxCell id="1. 2" value="Đơn vị phân tích: employee-day (user, D) · Cửa sổ 30 ngày [D-29, D] · Model không giám sát, không học nhãn · Nhãn (answer key) chỉ dùng ở bước Evaluation (label firewall) · Orchestrator: &lt;b&gt;python -m cli.run_experiment&lt;/b&gt; chạy tuần tự ①→⑧" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=11;whiteSpace=wrap;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="40" y="46" width="2000" height="30" as="geometry"/></mxCell><mxCell id="1. 3" value="Config" style="swimlane;horizontal=0;startSize=34;fontStyle=1;fontSize=14;rounded=0;html=1;whiteSpace=wrap;fillColor=#f5f5f5;strokeColor=#666666;swimlaneFillColor=#fbfbfb;" vertex="1" parent="1"><mxGeometry x="40" y="90" width="2620" height="110" as="geometry"/></mxCell><mxCell id="1. 4" value="&lt;b&gt;feature128.v5.json&lt;/b&gt;&lt;br&gt;• 128 feature: L18 D12 F24 H24 E26 X16 P08&lt;br&gt;• X12–X15 bị mask · 124 feature bật" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;fontSize=10;align=left;spacingLeft=8;verticalAlign=top;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="80" y="100" width="330" height="76" as="geometry"/></mxCell><mxCell id="1. 5" value="&lt;b&gt;sequence7.v4.json&lt;/b&gt;&lt;br&gt;• 7 token: LOGON, LOGOFF, DEVICE_CONNECT/DISCONNECT, FILE, HTTP, EMAIL&lt;br&gt;• max 256 event/ngày (128 đầu + 128 cuối)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;fontSize=10;align=left;spacingLeft=8;verticalAlign=top;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="430" y="100" width="380" height="76" as="geometry"/></mxCell><mxCell id="1. 6" value="&lt;b&gt;model.tcn_transformer_ae.v4.json&lt;/b&gt;&lt;br&gt;• kiến trúc, embedding dims, loss 0.5/0.5" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;fontSize=10;align=left;spacingLeft=8;verticalAlign=top;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="830" y="100" width="290" height="76" as="geometry"/></mxCell><mxCell id="1. 7" value="&lt;b&gt;backend/config/framework.v7.json&lt;/b&gt;&lt;br&gt;• split, readiness P→R→G, fusion = noisy_or.v1&lt;br&gt;• threshold: Validation quantile 0.995, labels_used=false" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;fontSize=10;align=left;spacingLeft=8;verticalAlign=top;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="1140" y="100" width="400" height="76" as="geometry"/></mxCell><mxCell id="1. 8" value="&lt;b&gt;Split cố định (inclusive)&lt;/b&gt;&lt;br&gt;• TRAIN 2010-01-02 → 2010-05-31&lt;br&gt;• VALIDATION 2010-06-01 → 2010-09-30&lt;br&gt;• TEST 2010-10-01 → 2011-05-17" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;fontSize=10;align=left;spacingLeft=8;verticalAlign=top;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="1560" y="100" width="300" height="76" as="geometry"/></mxCell><mxCell id="1. 9" value="&lt;b&gt;Artifact integrity&lt;/b&gt;&lt;br&gt;• atomic write + SHA-256 manifest&lt;br&gt;• resume theo source / epoch / score CSV&lt;br&gt;• checksum lệch → từ chối, không trộn" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;fontSize=10;align=left;spacingLeft=8;verticalAlign=top;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="1880" y="100" width="300" height="76" as="geometry"/></mxCell><mxCell id="1. 10" value="A. Dữ liệu &amp;amp; Materialization" style="swimlane;horizontal=0;startSize=34;fontStyle=1;fontSize=14;rounded=0;html=1;whiteSpace=wrap;fillColor=#fff2cc;strokeColor=#d6b656;swimlaneFillColor=#fffdf5;" vertex="1" parent="1"><mxGeometry x="40" y="220" width="2620" height="330" as="geometry"/></mxCell><mxCell id="1. 11" value="&lt;b&gt;CERT r4.2 raw (data/raw/cert4.2)&lt;/b&gt;&lt;br&gt;• logon.csv&lt;br&gt;• device.csv&lt;br&gt;• file.csv  (copy → removable media)&lt;br&gt;• http.csv  (~15 GB)&lt;br&gt;• email.csv&lt;br&gt;• LDAP/*.csv (role snapshots theo tháng)" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=12;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;align=left;spacingLeft=6;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="90" y="250" width="250" height="170" as="geometry"/></mxCell><mxCell id="1. 12" value="&lt;b&gt;① cli.build_store  —  insider_ml/stream_store.py&lt;/b&gt;&lt;br&gt;• Stream &lt;b&gt;1 source × 1 ngày&lt;/b&gt; (ít RAM), metadata-only&lt;br&gt;• Canonical event, sort: timestamp → source_rank → event_uid&lt;br&gt;• LDAP → role timeline effective-dated, role epoch&lt;br&gt;• PC profile &lt;b&gt;Train-only&lt;/b&gt;, frozen: OWN / SHARED / FOREIGN / UNKNOWN&lt;br&gt;• History/temporal state &lt;b&gt;past-only&lt;/b&gt; (chỉ ngày &amp;lt; D)&lt;br&gt;• Aggregate → &lt;b&gt;Feature128&lt;/b&gt; (values + mask) mỗi user-day&lt;br&gt;• Event list → &lt;b&gt;Sequence7&lt;/b&gt; + side channels (PC, calendar, gap, time sin/cos)&lt;br&gt;• Robust scaler median/MAD fit trên Train&lt;br&gt;• Checkpoint hoàn thành theo từng raw source (resume)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=left;spacingLeft=8;spacingRight=6;verticalAlign=top;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="400" y="245" width="470" height="225" as="geometry"/></mxCell><mxCell id="1. 13" value="&lt;b&gt;SQLite user-day store&lt;/b&gt;&lt;br&gt;data/processed/&lt;br&gt;cert4.2_user_days.sqlite&lt;br&gt;(+ manifest.json)" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=10;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="930" y="285" width="200" height="120" as="geometry"/></mxCell><mxCell id="1. 14" value="&lt;b&gt;Preflight (run_experiment)&lt;/b&gt;&lt;br&gt;• _validate_full_store: store hoàn chỉnh,&lt;br&gt;• không cap user, đếm split,&lt;br&gt;• readiness preflight" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;fontSize=10;align=left;spacingLeft=8;verticalAlign=top;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="1190" y="250" width="260" height="90" as="geometry"/></mxCell><mxCell id="1. 15" value="&lt;b&gt;SQLiteWindowDataset  —  insider_ml/dataset.py&lt;/b&gt;&lt;br&gt;• Dựng cửa sổ 30 ngày &lt;b&gt;[D-29, D]&lt;/b&gt; khi được yêu cầu&lt;br&gt;• Không dùng ngày sau D&lt;br&gt;• Ngày inactive vẫn giữ trong universe&lt;br&gt;• Tensor: feature[30,128], mask[30,128], seq tokens[30,256] + side" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=8;spacingRight=6;verticalAlign=top;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="1190" y="360" width="420" height="120" as="geometry"/></mxCell><mxCell id="1. 16" value="5 log + LDAP" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="1. 11" target="1. 12"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="1. 17" value="ghi aggregate / tensor" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="1. 12" target="1. 13"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="1. 18" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=open;endFill=0;strokeWidth=1.2;dashed=1;strokeColor=#666666;fontColor=#666666;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="1. 13" target="1. 14"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="1. 19" value="đọc theo cửa sổ" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="1. 13" target="1. 15"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="1. 20" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=open;endFill=0;strokeWidth=1.2;dashed=1;strokeColor=#666666;fontColor=#666666;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="1. 4" target="1. 12"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="1. 21" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=open;endFill=0;strokeWidth=1.2;dashed=1;strokeColor=#666666;fontColor=#666666;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="1. 5" target="1. 12"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="1. 22" value="B. Train (không nhãn)" style="swimlane;horizontal=0;startSize=34;fontStyle=1;fontSize=14;rounded=0;html=1;whiteSpace=wrap;fillColor=#dae8fc;strokeColor=#6c8ebf;swimlaneFillColor=#f7faff;" vertex="1" parent="1"><mxGeometry x="40" y="570" width="2620" height="250" as="geometry"/></mxCell><mxCell id="1. 23" value="&lt;b&gt;② cli.train  —  training.py + model.py&lt;/b&gt;&lt;br&gt;• Endpoint policy &lt;b&gt;WEEKLY_TRAIN&lt;/b&gt;: mỗi user 1 endpoint/tuần,&lt;br&gt;•   stagger = sha256(user_id)[:4] mod 7&lt;br&gt;• Mỗi sample vẫn reconstruct đủ 30 ngày&lt;br&gt;• total_loss = 0.5 × feature_loss + 0.5 × sequence_loss (PAD bỏ qua)&lt;br&gt;• Checkpoint nguyên tử sau mỗi epoch, --resume&lt;br&gt;• vd: --epochs 20 --batch-size 4 --device auto" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=left;spacingLeft=8;spacingRight=6;verticalAlign=top;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="1190" y="605" width="450" height="170" as="geometry"/></mxCell><mxCell id="1. 24" value="&lt;b&gt;TCN–Transformer Autoencoder (xem trang 2)&lt;/b&gt;&lt;br&gt;• Feature encoder 256→128→64&lt;br&gt;• Sequence encoder: event emb 37 → Conv1D → masked mean 64&lt;br&gt;• Day emb 128 → Residual TCN d=[1,2,4,8]&lt;br&gt;• → Transformer 2 layers, 4 heads, FFN 256&lt;br&gt;• → Decoder Feature128 + token/PC/calendar/gap/time" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;align=left;spacingLeft=8;spacingRight=6;verticalAlign=top;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="1700" y="605" width="400" height="150" as="geometry"/></mxCell><mxCell id="1. 25" value="&lt;b&gt;Checkpoint&lt;/b&gt;&lt;br&gt;data/artifacts/experiment_v3/&lt;br&gt;tcn_transformer_ae.v4.pt" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=10;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="2170" y="625" width="220" height="110" as="geometry"/></mxCell><mxCell id="1. 26" value="TRAIN windows" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="1. 15" target="1. 23"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="1. 27" value="fit" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="1. 23" target="1. 24"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="1. 28" value="save / epoch" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="1. 24" target="1. 25"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="1. 29" value="C. Score · Reference · Calibration · Fusion" style="swimlane;horizontal=0;startSize=34;fontStyle=1;fontSize=14;rounded=0;html=1;whiteSpace=wrap;fillColor=#e1d5e7;strokeColor=#9673a6;swimlaneFillColor=#fcf9fd;" vertex="1" parent="1"><mxGeometry x="40" y="840" width="2620" height="390" as="geometry"/></mxCell><mxCell id="1. 30" value="&lt;b&gt;③ cli.score --split TRAIN --fit-reference-out&lt;/b&gt;&lt;br&gt;• Inference: chỉ lấy reconstruction error của &lt;b&gt;ngày cuối D&lt;/b&gt;&lt;br&gt;• → feature_raw(D) = E_F,  sequence_raw(D) = E_S&lt;br&gt;• Dùng &lt;b&gt;tất cả&lt;/b&gt; endpoint Train để fit reference&lt;br&gt;• Fit empirical CDF (sorted_scores) cho mỗi branch × level" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=left;spacingLeft=8;spacingRight=6;verticalAlign=top;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="90" y="880" width="420" height="130" as="geometry"/></mxCell><mxCell id="1. 31" value="train_raw_scores.csv&lt;br&gt;(+ manifest)" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=12;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;align=left;spacingLeft=6;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="120" y="1060" width="160" height="70" as="geometry"/></mxCell><mxCell id="1. 32" value="&lt;b&gt;references.train.json  (FROZEN)&lt;/b&gt;&lt;br&gt;• PERSON: user × role epoch&lt;br&gt;• ROLE: peer cùng role&lt;br&gt;• GLOBAL: toàn bộ Train&lt;br&gt;• support_json + fitted_through &amp;lt; D" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=12;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;align=left;spacingLeft=6;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="300" y="1045" width="230" height="120" as="geometry"/></mxCell><mxCell id="1. 33" value="&lt;b&gt;④ cli.score --split VALIDATION --reference-in&lt;/b&gt;&lt;br&gt;• Raw E_F, E_S cho mọi employee-day (full LDAP universe)&lt;br&gt;• &lt;b&gt;Readiness&lt;/b&gt; độc lập từng branch: PERSON → ROLE → GLOBAL → NO_SCORE&lt;br&gt;• &lt;b&gt;Calibration&lt;/b&gt;: q = ECDF percentile trong reference đã chọn&lt;br&gt;• &lt;b&gt;Fusion v7&lt;/b&gt; noisy_or: risk = 1 − (1−q_F)(1−q_S)&lt;br&gt;•   1 branch thiếu → risk = branch còn lại; cả 2 thiếu → NO_SCORE&lt;br&gt;• Ngày inactive (seq_len &amp;lt; 2 …) → NO_SCORE" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=left;spacingLeft=8;spacingRight=6;verticalAlign=top;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="600" y="880" width="460" height="160" as="geometry"/></mxCell><mxCell id="1. 34" value="validation_predictions.csv&lt;br&gt;(+ manifest: scored, readiness_outcomes)" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=12;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;align=left;spacingLeft=6;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="690" y="1090" width="280" height="70" as="geometry"/></mxCell><mxCell id="1. 35" value="&lt;b&gt;⑥ cli.evaluate_metrics --split VALIDATION&lt;/b&gt;&lt;br&gt;• Chọn threshold = empirical quantile &lt;b&gt;0.995&lt;/b&gt; của risk&lt;br&gt;• &lt;b&gt;Không đọc label&lt;/b&gt; khi chọn threshold&lt;br&gt;• Tính metric Validation (tham khảo)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=left;spacingLeft=8;spacingRight=6;verticalAlign=top;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="1130" y="880" width="380" height="110" as="geometry"/></mxCell><mxCell id="1. 36" value="&lt;b&gt;LOCKED threshold&lt;/b&gt;&lt;br&gt;(đóng băng trước Test)" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1200" y="1060" width="200" height="70" as="geometry"/></mxCell><mxCell id="1. 37" value="&lt;b&gt;⑦ cli.score --split TEST --reference-in&lt;/b&gt;&lt;br&gt;• Cùng checkpoint + cùng frozen references&lt;br&gt;• Readiness → Calibration → Fusion như ④" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=left;spacingLeft=8;spacingRight=6;verticalAlign=top;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="1580" y="880" width="360" height="95" as="geometry"/></mxCell><mxCell id="1. 38" value="test_predictions.csv&lt;br&gt;(+ manifest)" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=12;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;align=left;spacingLeft=6;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="1660" y="1060" width="200" height="70" as="geometry"/></mxCell><mxCell id="1. 39" value="&lt;b&gt;⑧ cli.evaluate_metrics --split TEST --threshold &amp;lt;locked&amp;gt;&lt;/b&gt;&lt;br&gt;• AUPRC, ROC-AUC, Precision / Recall / F1, TP FP TN FN&lt;br&gt;• Recall@Top-10/day, alerts/day, FP / 1.000 user-days&lt;br&gt;• Incident detection rate, time-to-detect, scenario recall&lt;br&gt;• PERSON/ROLE/GLOBAL/NO_SCORE rate&lt;br&gt;• User-block bootstrap CI 95% (1000 replicates)&lt;br&gt;• Missing prediction = NO_SCORE, risk hiệu dụng 0" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=left;spacingLeft=8;spacingRight=6;verticalAlign=top;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="2000" y="880" width="420" height="160" as="geometry"/></mxCell><mxCell id="1. 40" value="&lt;b&gt;experiment_report.json&lt;/b&gt;&lt;br&gt;validation.metrics.json&lt;br&gt;test.metrics.json" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=10;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="2130" y="1090" width="220" height="90" as="geometry"/></mxCell><mxCell id="1. 41" value="checkpoint" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="1. 25" target="1. 30"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="2280" y="830"/><mxPoint x="300" y="830"/></Array></mxGeometry></mxCell><mxCell id="1. 42" value="TRAIN windows" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="1. 15" target="1. 30"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1400" y="520"/><mxPoint x="160" y="520"/></Array></mxGeometry></mxCell><mxCell id="1. 43" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="1. 30" target="1. 31"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="1. 44" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="1. 30" target="1. 32"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="1. 45" value="frozen refs" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#ffffff;exitX=