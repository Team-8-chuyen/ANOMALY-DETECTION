metry"></mxGeometry></mxCell><mxCell id="2. 9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="2. 5" target="2. 6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="2. 10" value="Sequence branch" style="swimlane;horizontal=0;startSize=34;fontStyle=1;fontSize=14;rounded=0;html=1;whiteSpace=wrap;fillColor=#e1d5e7;strokeColor=#9673a6;swimlaneFillColor=#fcf9fd;" vertex="1" parent="1"><mxGeometry x="40" y="290" width="900" height="250" as="geometry"/></mxCell><mxCell id="2. 11" value="&lt;b&gt;Per-event embedding = 37&lt;/b&gt;&lt;br&gt;token Emb(8, 24)&lt;br&gt;+ PC context Emb(5, 4)&lt;br&gt;+ calendar Emb(3, 3)&lt;br&gt;+ gap bucket Emb(·, 4)&lt;br&gt;+ time sin/cos (2)" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=12;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;align=left;spacingLeft=6;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="90" y="320" width="200" height="190" as="geometry"/></mxCell><mxCell id="2. 12" value="&lt;b&gt;Event TCN&lt;/b&gt;&lt;br&gt;Conv1D(37→64,k=3) + GELU&lt;br&gt;Conv1D(64→64,k=3) + GELU" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="330" y="370" width="200" height="80" as="geometry"/></mxCell><mxCell id="2. 13" value="&lt;b&gt;Masked mean pooling&lt;/b&gt;&lt;br&gt;(bỏ PAD)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="560" y="380" width="140" height="60" as="geometry"/></mxCell><mxCell id="2. 14" value="&lt;b&gt;sequence emb 64&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="730" y="385" width="130" height="50" as="geometry"/></mxCell><mxCe