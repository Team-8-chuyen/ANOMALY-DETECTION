90" y="1280" width="260" height="110" as="geometry"/></mxCell><mxCell id="1. 56" value="&lt;b&gt;⑤ cli.prepare_evaluation  (VALIDATION / TEST)&lt;/b&gt;&lt;br&gt;• Universe = mọi (employee, day) có hiệu lực trong LDAP, gồm ngày inactive&lt;br&gt;• Positive = incident subject có ≥1 answer-key event trong ngày D&lt;br&gt;• Không mở rộng incident interval, không tính actor phụ" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;align=left;spacingLeft=8;verticalAlign=top;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="420" y="1280" width="460" height="110" as="geometry"/></mxCell><mxCell id="1. 57" value="data/evaluation/experiment_v3/&lt;br&gt;{split}_universe.csv&lt;br&gt;{split}_positive_labels.csv" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=12;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;align=left;spacingLeft=6;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="960" y="1290" width="260" height="90" as="geometry"/></mxCell><mxCell id="1. 58" value="&lt;b&gt;Label firewall&lt;/b&gt;&lt;br&gt;• validation.py quét đệ quy key: label, scenario, insider,&lt;br&gt;• malicious, ground_truth, answer_key, is_threat… → reject&lt;br&gt;• Evaluation DB tách vật lý, credential riêng" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;align=left;spacingLeft=8;verticalAlign=top;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="1300" y="1280" width="420" height="110" as="geometry"/></mxCell><mxCell id="1. 59" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="1. 55" target="1. 56"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="1. 60" value="LDAP" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=open;endFill=0;strokeWidth=1.2;dashed=1;strokeColor=#666666;fontColor=#666666;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="1. 11" target="1. 56"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="80" y="400"/><mxPoint x="80" y="1420"/><mxPoint x="650" y="1420"/></Array></mxGeometry></mxCell><mxCell id="1. 61" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="1. 56" target="1. 57"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="1. 62" value="chỉ để tính metric" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.5;dashed=1;strokeColor=#b85450;fontColor=#b85450;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="1. 57" target="1. 35"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1260" y="1335"/><mxPoint x="1260" y="1240"/><mxPoint x="1470" y="1240"/><mxPoint x="1470" y="990"/></Array></mxGeometry></mxCell><mxCell id="1. 63" value="labels + universe" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.5;dashed=1;strokeColor=#b85450;fontColor=#b85450;fontSize=10;labelBackgroundColor=#ffffff;entryX=0.95;entryY=1;" edge="1" parent="1" source="1. 57" target="1. 39"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1090" y="1440"/><mxPoint x="2399" y="1440"/></Array></mxGeometry></mxCell><mxCell id="1. 64" value="E. Backend vận hành (FastAPI)" style="swimlane;horizontal=0;startSize=34;fontStyle=1;fontSize=14;rounded=0;html=1;whiteSpace=wrap;fillColor=#ffe6cc;strokeColor=#d79b00;swimlaneFillColor=#fffbf5;" vertex="1" parent="1"><mxGeometry x="40" y="1470" width="2620" height="400" as="geometry"/></mxCell><mxCell id="1. 65" value="&lt;b&gt;Ingestion &amp;amp; identity  (API_KEY)&lt;/b&gt;&lt;br&gt;• POST /users, /roles, /users/{id}/role-assignments&lt;br&gt;• POST /ingestions, /ingestions/{id}/checkpoints&lt;br&gt;• POST /events/batch  → CanonicalEvent (idempotent, lineage)&lt;br&gt;• POST /user-days/{u}/{d}/features  (Feature128)&lt;br&gt;• POST /user-days/{u}/{d}/sequence  (Sequence7)&lt;br&gt;• Middleware: request-id, max bytes, label firewall" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;align=left;spacingLeft=8;spacingRight=6;verticalAlign=top;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="90" y="1510" width="420" height="160" as="geometry"/></mxCell><mxCell id="1. 66" value="&lt;b&gt;POST /artifacts, /references&lt;/b&gt;&lt;br&gt;• Nạp checkpoint manifest + frozen&lt;br&gt;• Person/Role/Global ReferenceProfile&lt;br&gt;• (sorted_scores, support_json, fitted_through)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;align=left;spacingLeft=8;spacingRight=6;verticalAlign=top;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="90" y="1700" width="420" height="110" as="geometry"/></mxCell><mxCell id="1. 67" value="&lt;b&gt;POST /assessments/score  (SCORER_API_KEY — trusted scorer)&lt;/b&gt;&lt;br&gt;• Scorer gửi raw E_F, E_S (không được gửi calibrated/support)&lt;br&gt;• domain/readiness.py: P→R→G độc lập, reason codes&lt;br&gt;• Server-side ECDF calibration → q_F, q_S&lt;br&gt;• domain/fusion.py: weighted_mean / noisy_or theo config&lt;br&gt;• So với LOCKED_ALERT_THRESHOLD" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;align=left;spacingLeft=8;spacingRight=6;verticalAlign=top;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="580" y="1510" width="460" height="150" as="geometry"/></mxCell><mxCell id="1. 68" value="&lt;b&gt;BranchScore ×2 + RiskAssessment&lt;/b&gt;&lt;br&gt;• immutable, lưu evidence, model/config version" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;align=left;spacingLeft=8;spacingRight=6;verticalAlign=top;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="1110" y="1510" width="300" height="70" as="geometry"/></mxCell><mxCell id="1. 69" value="&lt;b&gt;Alert (nếu risk ≥ threshold)&lt;/b&gt;&lt;br&gt;• GET /alerts · PATCH /alerts/{id}&lt;br&gt;• status / assignee / resolution — không sửa score" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;align=left;spacingLeft=8;verticalAlign=top;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="1110" y="1610" width="300" height="90" as="geometry"/></mxCell><mxCell id="1. 70" value="&lt;b&gt;POST /scoring-watermarks/close-day&lt;/b&gt;&lt;br&gt;• đóng ngày đã chấm đủ" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;align=left;spacingLeft=8;spacingRight=6;verticalAlign=top;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="1480" y="1510" width="300" height="60" as="geometry"/></mxCell><mxCell id="1. 71" value="&lt;b&gt;POST /safe-updates/process  (chỉ PRODUCTION, mặc định OFF)&lt;/b&gt;&lt;br&gt;• Score-first → SafeUpdateCandidate&lt;br&gt;• Quarantine [D, D+30] → eligible D+31&lt;br&gt;• Reject nếu có alert / đổi role epoch&lt;br&gt;• Accept → Person reference version mới (audit checksum)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;align=left;spacingLeft=8;spacingRight=6;verticalAlign=top;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="1480" y="1600" width="380" height="130" as="geometry"/></mxCell><mxCell id="1. 72" value="&lt;b&gt;Core DB&lt;/b&gt;&lt;br&gt;Organization, User, Role, RoleAssignment,&lt;br&gt;IngestionJob, CanonicalEvent, UserDayFeature,&lt;br&gt;UserDaySequence, ReferenceProfile, BranchScore,&lt;br&gt;RiskAssessment, Alert, SafeUpdateCandidate, AuditLog" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=10;fill